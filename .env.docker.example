# Portas publicadas no seu computador
ADMIN_PORT=3000
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# Aplicação
PORT=3000
NODE_ENV=development
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa
ADMIN_EMAIL=admin@ludus.local
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador
ADMIN_INSTITUICAO=Ludus
ADMIN_SEED_TOKEN=troque-por-um-token-secreto

# MongoDB: use os mesmos usuário e senha em MONGO_URI e MONGO_INITDB_*.
MONGO_INITDB_ROOT_USERNAME=ludus_root
MONGO_INITDB_ROOT_PASSWORD=troque-por-uma-senha-forte
MONGO_URI=mongodb://ludus_root:troque-por-uma-senha-forte@mongo:27017/ludus?authSource=admin

# Acesso HTTP ao Mongo Express
ME_CONFIG_MONGODB_URL=mongodb://ludus_root:troque-por-uma-senha-forte@mongo:27017/?authSource=admin
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=troque-esta-senha-tambem
